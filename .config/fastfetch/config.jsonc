{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "blue", "title": "blue" },
    "key": { "width": 10 },
    "bar": {
      "char": { "elapsed": "▰", "total": "▱" },
      "border": { "left": "", "right": "" },
      "width": 8,
      "color": { "elapsed": "blue", "total": "90" }
    },
    "percent": { "type": ["bar", "num"] }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
    { "type": "custom", "format": "\u001b[90m──────────────────────────" },
    { "type": "os",       "key": " os",     "format": "{pretty-name}" },
    { "type": "kernel",   "key": " kernel", "format": "{release}" },
    { "type": "wm",       "key": " wm",     "format": "{pretty-name}" },
    { "type": "shell",    "key": " shell",  "format": "{pretty-name}" },
    { "type": "terminal", "key": " term",   "format": "{pretty-name}" },
    { "type": "packages", "key": " pkgs" },
    { "type": "uptime",   "key": " uptime" },
    { "type": "custom", "format": "\u001b[90m──────────────────────────" },
    { "type": "cpu",      "key": " cpu",    "format": "{name}" },
    { "type": "gpu",      "key": " gpu",    "format": "{name}" },
    { "type": "memory",   "key": " mem",    "format": "{percentage-bar} {percentage}" },
    { "type": "disk",     "key": " disk",   "folders": "/", "format": "{size-percentage-bar} {size-percentage}" },
    "break",
    { "type": "custom", "format": "\u001b[31m\u25cf \u001b[32m\u25cf \u001b[33m\u25cf \u001b[34m\u25cf \u001b[35m\u25cf \u001b[36m\u25cf" }
  ]
}
