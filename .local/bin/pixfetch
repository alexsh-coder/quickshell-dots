#!/usr/bin/env python3
"""fastfetch with a random pixel-art logo.

Kitty: crisp integer-scaled image via the graphics protocol.
Elsewhere: truecolor half-block art, pokemon-colorscripts style.
Extra arguments are passed through to fastfetch.
PIXFETCH_ART=<file> pins the art (a shell keeps its picture across redraws),
`pixfetch --pick` prints a random one. PIXFETCH_REDRAW=1 clears the screen and
replays the rendered output atomically, from a short-lived cache.
"""
import fcntl
import hashlib
import json
import re
import time
import math
import os
import random
import struct
import subprocess
import sys
import termios
from pathlib import Path


Image = ImageChops = None  # PIL is slow to import; only needed on a cache miss

HOME = Path.home()
ART_DIR = Path(os.environ.get("PIXFETCH_DIR", HOME / "Pictures/pixel-art"))
CACHE = Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")) / "pixfetch"
ROWS = int(os.environ.get("PIXFETCH_ROWS", 17))
PROMPT_ROWS = int(os.environ.get("PIXFETCH_PROMPT_ROWS", 3))  # starship: blank + path + input
MAX_COLS = int(os.environ.get("PIXFETCH_MAX_COLS", 44))
INFO_COLS = 28  # widest fastfetch line + logo padding is added on top
INFO_ROWS = 17  # height of the fastfetch text block
MIN_SIDE = 16  # narrower art beside the text -> art only
MIN_ART = 8  # smaller than this in either direction -> print nothing
CROP = float(os.environ.get("PIXFETCH_CROP", 0.55))  # 0 disables
EXTS = {".png", ".gif", ".webp", ".bmp"}


CLEAR = b"\x1b_Ga=d,d=A\x1b\\\x1b[H\x1b[2J\x1b[3J"  # drop images, wipe screen and scrollback
REDRAW_TTL = 300  # seconds a replayed redraw may be stale (uptime, memory)


def fastfetch(*args, trim=False):
    tty = sys.stdout.isatty()
    redraw = tty and os.environ.get("PIXFETCH_REDRAW")
    cmd = ["fastfetch", "--pipe", str(not tty).lower(), *args, *sys.argv[1:]]
    cached = CACHE / ("out-" + hashlib.sha1(json.dumps(cmd).encode()).hexdigest()[:16])
    if redraw and cached.exists() and time.time() - cached.stat().st_mtime < REDRAW_TTL:
        out = cached.read_bytes()
    else:
        proc = subprocess.run(cmd, stdout=subprocess.PIPE)
        out = proc.stdout
        # fastfetch leaves one blank row under the logo; the prompt has its own.
        if trim:
            out = re.sub(rb"\n(?:\x1b\[[0-9;]*m| )*\n$", b"\n", out)
        if redraw and proc.returncode == 0:
            cached.write_bytes(out)
    # Autowrap off while printing: in a narrow window lines get cut at the edge
    # instead of wrapping and sliding the text off the art. One write, so a
    # redraw never shows a blank screen in between.
    head = b"\x1b[?7l" if tty else b""
    if redraw:
        head += CLEAR
    sys.stdout.buffer.write(head + out + (b"\x1b[?7h" if tty else b""))
    sys.stdout.flush()
    sys.exit(0)


def pick():
    pinned = os.environ.get("PIXFETCH_ART")
    if pinned and Path(pinned).is_file():
        return Path(pinned)
    files = sorted(p for p in ART_DIR.rglob("*") if p.suffix.lower() in EXTS)
    if not files:
        return None
    # Shuffle bag: every picture shows once before any repeats. The lock keeps
    # windows opened at the same moment from drawing the same one.
    with open(CACHE / "bag.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = CACHE / "bag.json"
        try:
            data = json.loads(state.read_text())
        except (OSError, ValueError):
            data = {}
        known = {str(f) for f in files}
        bag = [f for f in data.get("bag", []) if f in known]
        last = data.get("last", "")
        if not bag:
            bag = [str(f) for f in files]
            random.shuffle(bag)
            if len(bag) > 1 and bag[-1] == last:  # draws from the end
                bag[0], bag[-1] = bag[-1], bag[0]
        choice = bag.pop()
        state.write_text(json.dumps({"bag": bag, "last": choice}))
    return Path(choice)


def winsize():
    """(columns, rows, cell size in px or None)."""
    for fd in (sys.stdout.fileno(), sys.stdin.fileno()):
        try:
            rows, cols, xpx, ypx = struct.unpack(
                "HHHH", fcntl.ioctl(fd, termios.TIOCGWINSZ, b"\0" * 8))
        except OSError:
            continue
        if cols and rows:
            return cols, rows, (xpx // cols, ypx // rows) if xpx and ypx else None
    return 80, 24, None


def grid(img, axis):
    # gcd of the positions where a column (axis 0) or row (axis 1) changes.
    n = img.size[axis]
    shift = (1, 0) if axis == 0 else (0, 1)
    w, h = img.size
    a = img.crop((shift[0], shift[1], w, h))
    b = img.crop((0, 0, w - shift[0], h - shift[1]))
    d = ImageChops.difference(a, b)
    step = n
    for i in range(n - 1):
        box = (i, 0, i + 1, d.height) if axis == 0 else (0, i, d.width, i + 1)
        if d.crop(box).getbbox(alpha_only=False):
            step = math.gcd(step, i + 1)
            if step == 1:
                break
    return step


def native(img):
    # Undo integer nearest-neighbour upscales, common in art posted online.
    k = math.gcd(grid(img, 0), grid(img, 1))
    if k < 2:
        return img
    w, h = img.size
    return img.resize((w // k, h // k), Image.NEAREST)


def clear_background(img):
    # Solid backdrop (all four corners equal) -> transparent, so the art floats.
    w, h = img.size
    colors = {img.getpixel(c) for c in [(0, 0), (w - 1, 0), (0, h - 1), (w - 1, h - 1)]}
    if len(colors) == 1 and (bg := colors.pop())[3] == 255:
        r, g, b = ImageChops.difference(img.convert("RGB"), Image.new("RGB", img.size, bg[:3])).split()
        keep = ImageChops.lighter(ImageChops.lighter(r, g), b).point(lambda v: 255 if v else 0)
        img.putalpha(keep)
    return img


def load(path):
    global Image, ImageChops
    from PIL import Image, ImageChops
    # Preparing the source (grid detection, backdrop removal) is slow and does not
    # depend on the window, so it is done once per file.
    key = hashlib.sha1(json.dumps([str(path), path.stat().st_mtime, 1]).encode()).hexdigest()[:16]
    prepared = CACHE / f"art-{key}.png"
    if prepared.exists():
        return Image.open(prepared).convert("RGBA")
    img = Image.open(path).convert("RGBA")
    img = clear_background(native(img))
    bbox = img.getchannel("A").getbbox()
    img = img.crop(bbox) if bbox else img
    img.save(prepared, compress_level=1)
    return img


def fit(img, max_w, max_h):
    w, h = img.size
    if w <= max_w and h <= max_h:
        return img
    if h >= 1.5 * w and CROP:
        # Tall full-body art: keep the upper body so the face stays readable.
        ch = round(h * CROP)
        cw = min(w, round(ch * 0.8))
        img = img.crop(((w - cw) // 2, 0, (w + cw) // 2, ch))
        w, h = img.size
    s = min(max_w / w, max_h / h)
    return img.resize((max(1, round(w * s)), max(1, round(h * s))), Image.LANCZOS)


def kitty(img, cw, ch, max_cols, rows, out):
    img = fit(img, max_cols * cw, rows * ch)
    w, h = img.size
    k = max(1, min(rows * ch // h, max_cols * cw // w))
    img = img.resize((w * k, h * k), Image.NEAREST)
    cols, rows = -(-img.width // cw), -(-img.height // ch)
    # Pad to whole cells so the terminal never resamples (keeps pixels sharp).
    canvas = Image.new("RGBA", (cols * cw, rows * ch))
    canvas.paste(img, ((canvas.width - img.width) // 2, canvas.height - img.height))
    canvas.save(out)
    return cols, rows


def halfblocks(img, max_cols, rows, out):
    img = fit(img, max_cols, rows * 2)
    w, h = img.size
    px = img.load()

    def get(x, y):
        if y >= h:
            return None
        r, g, b, a = px[x, y]
        return (r, g, b) if a >= 128 else None

    lines = []
    for y in range(0, h, 2):
        line = ""
        for x in range(w):
            top, bot = get(x, y), get(x, y + 1)
            if top and bot:
                line += "\x1b[38;2;%d;%d;%dm\x1b[48;2;%d;%d;%dm▀" % (*top, *bot)
            elif top:
                line += "\x1b[49m\x1b[38;2;%d;%d;%dm▀" % top
            elif bot:
                line += "\x1b[49m\x1b[38;2;%d;%d;%dm▄" % bot
            else:
                line += "\x1b[0m "
        lines.append(line + "\x1b[0m")
    out.write_text("\n".join(lines) + "\n")


def main():
    CACHE.mkdir(parents=True, exist_ok=True)
    path = pick()
    if sys.argv[1:] == ["--pick"]:
        print(path or "")
        return
    if path is None:
        fastfetch()

    term_cols, term_rows, cell = winsize()
    if os.environ.get("TERM") != "xterm-kitty":
        cell = None
    # Keep the art and the prompt on screen together. Text beside the art only
    # when both the width and the height allow it; otherwise the art alone.
    free = term_rows - PROMPT_ROWS
    max_cols = min(MAX_COLS, term_cols - 5 - INFO_COLS)
    pos = ["--logo-padding-top", "0"]
    if max_cols >= MIN_SIDE and free - 1 >= INFO_ROWS:
        rows, extra = min(ROWS, free - 1), []
    else:
        # Art alone gets all the room there is.
        rows, max_cols = free, term_cols - 3
        extra = ["--structure", "break"]
        if max_cols < MIN_ART or rows < MIN_ART:
            # Nothing fits: a redraw still has to wipe the old art away.
            if sys.stdout.isatty() and os.environ.get("PIXFETCH_REDRAW"):
                sys.stdout.buffer.write(CLEAR)
                sys.stdout.flush()
            return
    key = json.dumps([str(path), path.stat().st_mtime, cell, rows, max_cols, CROP])
    base = CACHE / hashlib.sha1(key.encode()).hexdigest()[:16]

    if cell:
        out, meta = base.with_suffix(".png"), base.with_suffix(".size")
        if not (out.exists() and meta.exists()):
            meta.write_text("%d %d" % kitty(load(path), *cell, max_cols, rows, out))
        cols, nrows = meta.read_text().split()
        fastfetch(*pos, *extra, "--logo-type", "kitty-direct", "--logo", str(out),
                  "--logo-width", cols, "--logo-height", nrows, trim=bool(extra))

    out = base.with_suffix(".txt")
    if not out.exists():
        halfblocks(load(path), max_cols, rows, out)
    fastfetch(*pos, *extra, "--logo-type", "file-raw", "--logo", str(out), trim=bool(extra))


if __name__ == "__main__":
    main()
